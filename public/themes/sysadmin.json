{
  "name": "SysAdmin",
  "description": "System administrator theme with blue and green tones",
  "colors": {
    "primary": "#00aaff",
    "secondary": "#00ff88",
    "background": "#001122",
    "panel": "#002244",
    "text": "#ffffff",
    "border": "#00aaff",
    "accent": "#ff6600",
    "success": "#00ff88",
    "warning": "#ffaa00",
    "error": "#ff4444"
  },
  "fonts": {
    "main": "'Source Code Pro', 'Fira Code', monospace",
    "size": "13px"
  },
  "terminal": {
    "background": "#000022",
    "foreground": "#00aaff",
    "cursor": "#00ff88",
    "selection": "rgba(0, 170, 255, 0.3)"
  },
  "layout": {
    "panels": ["system-monitor", "terminal", "file-explorer"],
    "glow": true,
    "scanlines": false
  },
  "animations": {
    "glow": true,
    "scanlines": false,
    "fade": true,
    "pulse": false
  }
}